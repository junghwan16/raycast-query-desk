{
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}
